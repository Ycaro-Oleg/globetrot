{
  "name": "@globetrot/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs: hourly housekeeping (unplaced uploads, stray stored images, old idempotency records)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@globetrot/application": "workspace:*",
    "@globetrot/db": "workspace:*",
    "@globetrot/mailer": "workspace:*",
    "@globetrot/storage": "workspace:*"
  },
  "devDependencies": {
    "@globetrot/config": "workspace:*",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
