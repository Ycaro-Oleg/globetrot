{
  "name": "@globetrot/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP adapter (Hono + OpenAPI) over @globetrot/application",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@globetrot/application": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@globetrot/config": "workspace:*",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
