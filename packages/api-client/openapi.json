{
  "openapi": "3.1.0",
  "info": {
    "title": "Globetrot API",
    "version": "1.0.0",
    "description": "Operations of the Globetrot application. Authenticated with the session cookie set by `/api/auth/*`; the caller is always the session owner and no request field can name another user."
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "globetrot.session_token",
        "description": "The session cookie set by sign-in (`__Secure-globetrot.session_token` over https). Browsers send it by themselves."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": [
          "Account"
        ],
        "summary": "The signed-in user",
        "description": "Only the caller’s own id, email, name and whether the email is verified.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller’s account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "emailVerified": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "name",
                    "emailVerified"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "A URN identifying the kind of problem."
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string",
                      "description": "Stable machine-readable code. Clients switch on this."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "field",
                          "code",
                          "message"
                        ]
                      },
                      "description": "Per-field problems, present for VALIDATION_FAILED."
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The session’s account no longer exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "A URN identifying the kind of problem."
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string",
                      "description": "Stable machine-readable code. Clients switch on this."
                    },
                    "detail": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "field",
                          "code",
                          "message"
                        ]
                      },
                      "description": "Per-field problems, present for VALIDATION_FAILED."
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
