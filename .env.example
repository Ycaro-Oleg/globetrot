# Local development defaults. Copy to `.env` (git-ignored): cp .env.example .env
# These values are for local Docker services only. They are NOT secrets; never put real credentials here.

# --- PostgreSQL + PostGIS (compose service: postgres) ---
POSTGRES_DB=globetrot
POSTGRES_USER=globetrot
POSTGRES_PASSWORD=globetrot
# Host port; 5455 avoids clashing with a Postgres already running on 5432.
POSTGRES_PORT=5455
DATABASE_URL=postgres://globetrot:globetrot@localhost:5455/globetrot

# --- S3-compatible object storage (compose service: storage, SeaweedFS) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=globetrot-media
S3_ACCESS_KEY_ID=globetrot-dev
S3_SECRET_ACCESS_KEY=globetrot-dev-secret
# SeaweedFS (like most self-hosted S3) needs path-style URLs.
S3_FORCE_PATH_STYLE=true

# --- Email (compose service: mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_FROM="Globetrot <hello@globetrot.local>"

# --- Apps ---
WEB_PORT=3000
API_PORT=4000
