# Local development defaults. Copy to `.env` (git-ignored): cp .env.example .env
# These values are for local Docker services only. They are NOT secrets; never put real credentials here.

# --- PostgreSQL + PostGIS (compose service: postgres) ---
POSTGRES_DB=globetrot
POSTGRES_USER=globetrot
POSTGRES_PASSWORD=globetrot
# Host port; 5455 avoids clashing with a Postgres already running on 5432.
POSTGRES_PORT=5455
DATABASE_URL=postgres://globetrot:globetrot@localhost:5455/globetrot

# --- S3-compatible object storage (compose service: storage, SeaweedFS) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=globetrot-media
S3_ACCESS_KEY_ID=globetrot-dev
S3_SECRET_ACCESS_KEY=globetrot-dev-secret
# SeaweedFS (like most self-hosted S3) needs path-style URLs.
S3_FORCE_PATH_STYLE=true

# --- Email (compose service: mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_FROM="Globetrot <hello@globetrot.local>"

# --- Apps ---
# API_PORT is read by the API (the platform's PORT wins). The web app listens on 3000 by default; to change it use
# PORT=3001 pnpm --filter @globetrot/web dev
API_PORT=4000

# --- Feature flags (apps/web; docs/engineering/configuration.md) ---
# Pip, the travel companion, is not built yet. `true` only shows its entry points and a placeholder page.
FEATURE_PIP=false

# --- Map (apps/web; docs/engineering/configuration.md) ---
# Public browser key for the map tiles and place search (Geoapify). It is written into the web bundle at BUILD time, and
# Next.js reads it from apps/web/.env.local (git-ignored), NOT from this root file. Without it the board still opens
# but place search is shown as unavailable. Restrict the key to your domains in the Geoapify dashboard.
# NEXT_PUBLIC_GEOAPIFY_API_KEY=

# --- Authentication (apps/api; see docs/architecture/authentication.md) ---
# The public development secret: fine locally, REFUSED when NODE_ENV=production.
# In production set a real one (openssl rand -base64 32) in Coolify, never in this file.
BETTER_AUTH_SECRET=insecure-local-development-secret-never-use-in-production
# Public origin of the WEB app. The browser only talks to it; it proxies /api/auth/* to the API.
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call /api/auth/* (comma separated). BETTER_AUTH_URL is always trusted.
TRUSTED_ORIGINS=
# Email verification and password reset (docs/architecture/authentication.md). SMTP_HOST, SMTP_PORT and
# EMAIL_FROM above point at Mailpit (http://localhost:8025 shows the mail). Production needs SMTP_HOST and
# EMAIL_FROM set to a real provider, plus SMTP_USER and SMTP_PASSWORD if it asks for them (set in Coolify).
# A password sign-in needs a verified email. Set to false to let unverified accounts in (not recommended).
REQUIRE_VERIFIED_EMAIL=true
# Google sign-in (#55): both or neither. Without them the Google button is hidden and nothing else changes. Create a
# Google OAuth *test* client, allow the redirect URI <BETTER_AUTH_URL>/api/auth/callback/google, and put the real values
# in your git-ignored .env or in Coolify, never in this file.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional knobs (defaults shown):
# VERIFICATION_EXPIRES_IN_SECONDS=86400
# RESET_PASSWORD_EXPIRES_IN_SECONDS=3600
# EMAIL_COOLDOWN_SECONDS=30
# AUTH_EMAIL_REQUESTS_PER_MINUTE=5
# SESSION_EXPIRES_IN_SECONDS=2592000
# SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_SIGN_IN_ATTEMPTS_PER_MINUTE=5
# AUTH_SIGN_UP_ATTEMPTS_PER_MINUTE=5
# Where the web app's server reaches the API. Next.js reads apps/web/.env*, NOT this root file:
# for `pnpm dev` the default (http://localhost:4000) already works.
# API_INTERNAL_URL=http://localhost:4000

# Pip (AI companion, behind FEATURE_PIP): a DeepSeek server key, kept secret. Unset: asking Pip answers 503.
# DEEPSEEK_API_KEY=

# Payments (ADR-0019). All STRIPE_* together or none; unset keeps checkout off (503). Test keys only outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPLORER_MONTHLY=
STRIPE_PRICE_EXPLORER_YEARLY=
STRIPE_PRICE_VOYAGER_MONTHLY=
STRIPE_PRICE_VOYAGER_YEARLY=
STRIPE_PRICE_TOP_UP=
